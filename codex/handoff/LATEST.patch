++data class CounterValue(val current: Int, val total: Int)
++
++fun parseCounter(raw: String, prefix: String? = null): CounterValue? {
++    val normalized = normalizeOcrText(raw)
++    val pattern = if (prefix == null) Regex("(?:^|[^0-9])(\\d{1,3})/(\\d{1,3})(?:$|[^0-9])")
