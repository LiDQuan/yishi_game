# Copy required values to ~/.config/yishijieyongzhe/secrets.env.
# Prefer macOS Keychain for long-lived credentials.
GITEE_TOKEN=YOUR_TOKEN_HERE
GITHUB_TOKEN=YOUR_TOKEN_HERE
API_TOKEN=YOUR_TOKEN_HERE
ANDROID_KEYSTORE_PATH=/path/to/private/app.keystore
ANDROID_KEYSTORE_PASSWORD=YOUR_PASSWORD_HERE
ANDROID_KEY_ALIAS=YOUR_KEY_ALIAS_HERE
ANDROID_KEY_PASSWORD=YOUR_PASSWORD_HERE
